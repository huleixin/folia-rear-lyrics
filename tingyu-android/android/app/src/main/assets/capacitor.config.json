{
	"appId": "io.github.huleixin.tingyu",
	"appName": "听屿",
	"webDir": "dist",
	"loggingBehavior": "debug",
	"backgroundColor": "#00000000",
	"android": {
		"allowMixedContent": true
	},
	"server": {
		"androidScheme": "https",
		"hostname": "localhost",
		"cleartext": false
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "disable"
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 0,
			"backgroundColor": "#00000000",
			"showSpinner": false
		},
		"StatusBar": {
			"overlaysWebView": true,
			"style": "LIGHT",
			"backgroundColor": "#00000000"
		}
	}
}
